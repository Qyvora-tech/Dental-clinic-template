# ====================================================================
# Hostinger / Apache / LiteSpeed Web Server Configuration
# City Smiles Dental & Skin Clinic
# ====================================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (optional - uncomment if SSL is active on Hostinger)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow direct access to real files and directories (images, styles, scripts)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for client-side routing on static hosting
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Security Headers
<IfModule mod_headers.c>
  # Protect against MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Protect against clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Control referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable unwanted device permissions
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Cross-Origin resource policy
  Header set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# 3. Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 4. MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents (always revalidate to get fresh updates)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript and data
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"

  # Images and Media
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 6. Immutable Caching for Hashed Build Assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 7. Disable Directory Browsing
Options -Indexes
